// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================================
// Transfer — Core entity
// ===================================
model Transfer {
  id                    String   @id @default(cuid())
  codeLookupHash        String   @unique @map("code_lookup_hash")
  // The plaintext code is returned to the user but stored only as HMAC hash
  displayCode           String   @map("display_code") // Stored for display only after creation
  originalFilename      String   @map("original_filename")
  objectKey             String   @map("object_key")
  fileSize              BigInt   @map("file_size")
  contentType           String   @map("content_type")
  checksumAlgorithm     String?  @map("checksum_algorithm")
  checksumValue         String?  @map("checksum_value")
  integrityStatus       String   @default("pending") @map("integrity_status") // pending | verified | failed
  uploadStatus          String   @default("pending") @map("upload_status") // pending | uploading | finalizing | completed | failed | abandoned
  passwordHash          String?  @map("password_hash")
  senderMessage         String?  @map("sender_message")
  allowPreview          Boolean  @default(true) @map("allow_preview")
  allowOriginalDownload Boolean  @default(true) @map("allow_original_download")
  downloadLimit         Int?     @map("download_limit")
  downloadCount         Int      @default(0) @map("download_count")
  previewObjectKey      String?  @map("preview_object_key")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  uploadSessions UploadSession[]
  events         TransferEvent[]

  @@index([uploadStatus])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("transfers")
}

// ===================================
// Upload Session — Tracks multipart uploads
// ===================================
model UploadSession {
  id             String   @id @default(cuid())
  transferId     String   @map("transfer_id")
  storageUploadId String  @map("storage_upload_id") // S3/R2 multipart upload ID
  objectKey      String   @map("object_key")
  uploadStatus   String   @default("pending") @map("upload_status") // pending | uploading | completed | failed | abandoned
  totalParts     Int      @map("total_parts")
  partSize       Int      @map("part_size")
  uploadedParts  Json     @default("[]") @map("uploaded_parts") // JSON array of {partNumber, etag, size}

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([uploadStatus])
  @@map("upload_sessions")
}

// ===================================
// Transfer Event — Audit log
// ===================================
model TransferEvent {
  id         String   @id @default(cuid())
  transferId String   @map("transfer_id")
  eventType  String   @map("event_type") // upload_completed | transfer_viewed | download_authorized | download_started
  metadata   Json?    @default("{}")
  ipHash     String?  @map("ip_hash") // Hashed IP for abuse detection, not tracking

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([eventType])
  @@index([createdAt])
  @@map("transfer_events")
}

// ===================================
// User — Optional, for transfer history
// ===================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
